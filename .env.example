# Plaid Dashboard → Team Settings → Keys (use Sandbox)
PLAID_CLIENT_ID=your_plaid_client_id
PLAID_SECRET=your_plaid_sandbox_secret

# sandbox | development | production
PLAID_ENV=sandbox

# Comma-separated Plaid products
PLAID_PRODUCTS=transactions

# Exposed to the browser for Link environment hints (optional)
NEXT_PUBLIC_PLAID_ENV=sandbox

# MongoDB. Outside production, the app defaults to mongodb://127.0.0.1:27017
# Use a local MongoDB Community install, or a MongoDB Atlas connection string.
MONGODB_URI=mongodb://127.0.0.1:27017
MONGODB_DB=mint_finance

# Authentication. Use exactly two comma-separated email addresses.
AUTH_DISABLED=false
ALLOWED_EMAILS=person-one@example.com,person-two@example.com
# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=replace-with-a-random-secret-at-least-32-characters
# Public application origin; use your canonical HTTPS URL in production.
BETTER_AUTH_URL=http://localhost:4317
